POSTGRES_PASSWORD=change-me
# Anyone with this code can create an account. Empty it once everyone is in.
KIMBISS_INVITE_CODE=
KIMBISS_ESTIMATES_PER_DAY=30
KIMBISS_PORT=8090
# `claude setup-token` on any machine with a browser, or an API key instead.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Server only (docker-compose.server.yml), see docs/SERVER.md.
KIMBISS_DOMAIN=kimbiss.lukasbreuer.de
KIMBISS_HTTP_PORT=8088
KIMBISS_HTTPS_PORT=8443
